# Archivos y carpetas que NO deben subir al editor web de Apps Script.
# Con rootDir="src" en .clasp.json, clasp ya solo mira dentro de src/,
# asi que aqui basta con excluir backups y temporales dentro de esa carpeta.

# Backups y temporales
*.bak
*.bak.*
*.tmp
*.swp

# Plantilla del manifest, solo se usa en local. El manifest real que
# sube a Apps Script es src/appsscript.json, generado por setup.
appsscript.template.json
